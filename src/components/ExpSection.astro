          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
      <div class="timeline-start mb-10 md:text-end">
        <time class="biz-regular text-lime">2023</time>
        <div class="text-lg font-black onest-bold text-white">1st Year</div>
        <p class="onest-regular text-white/70">Started university, diving into software development</p>
