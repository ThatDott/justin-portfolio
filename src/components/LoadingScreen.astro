<div
  id="loading-screen"
  class="fixed inset-0 h-screen w-screen z-[200] flex flex-col items-center justify-center"
  style="background-color: rgba(10, 9, 3, 1); backdrop-filter: blur(12px);"
>
  <p id="loading-text" class="biz-regular text-white text-lg tracking-widest">unlocking portfolio...</p>
</div>

<script>
  import gsap from "gsap";

  document.body.style.overflow = "hidden";

  function dismissLoadingScreen() {
    const el = document.getElementById("loading-screen");
    const p = document.getElementById("loading-text");
    if (!el) return;

    const text = document.getElementById("loading-text");

    const tl = gsap.timeline({
      onComplete: () => {
        document.body.style.overflow = "";
        el.remove();
      },
    });

    tl.to(text, { opacity: 0, duration: 1, ease: "none" }, "<")
      .to(el, {
        backgroundColor: "rgba(10, 9, 3, 0)",
        backdropFilter: "blur(0px)",
        duration: 0.8,
        ease: "power2.inOut",
      });
  }

  window.addEventListener("load", () => {
    setTimeout(dismissLoadingScreen, 1000);
  });
</script>
